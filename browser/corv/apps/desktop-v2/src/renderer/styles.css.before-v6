* { box-sizing: border-box; }
:root {
  /* Shift-exact palette (pixel-sampled from reference screenshot) */
  --rail-w: 44px;
  --tabs-h: 36px;
  --toolbar-h: 46px;
  --shell: #262626;
  --tab-strip: #1b1b1b;
  --toolbar: #404040;
  --page: #3c3c3c;
  --page-2: #3c3c3c;
  --muted: #b9b9b9;
  --blue: #8dbdf3;
  --tab-inactive: #272727;
  --tab-active: #3a3a3a;
  --omnibox-bg: #262626;
}
html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
body { background: var(--shell); color: #f5f6f7; font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
button, input { font: inherit; }
button { border: 0; color: inherit; cursor: pointer; }
button:focus-visible, input:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
svg { width: 100%; height: 100%; display: block; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
.vshell { position: relative; width: 100vw; height: 100vh; display: grid; grid-template-columns: var(--rail-w) minmax(0,1fr); grid-template-rows: var(--tabs-h) minmax(0,1fr); grid-template-areas: "tabs tabs" "rail window"; background: var(--shell); }

/* Smooth VCorv rail */
.app-rail { grid-area: rail; position: relative; z-index: 5; width: var(--rail-w); min-height: 0; margin: 0; display: flex; flex-direction: column; align-items: center; padding: 8px 4px 10px 4px; overflow: visible; background: var(--toolbar); }
.avatar-button { position: relative; width: 30px; height: 30px; padding: 0; border-radius: 50%; background: transparent; }
.avatar-circle { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: #34776b; color: #f9fafb; font-size: 13px; font-weight: 650; }
.rail-app svg { width: 19px; height: 19px; }
.brand-button { width: 38px; height: 32px; display: grid; place-items: center; padding: 0; border-radius: 9px; background: transparent; }
.brand-button img { width: 31px; height: 27px; object-fit: contain; filter: drop-shadow(0 3px 8px rgba(0,0,0,.48)); }
.rail-primary { display: grid; margin-top: 15px; }
.rail-secondary { display: grid; justify-items: center; gap: 14px; margin-top: auto; margin-bottom: 6px; }
.brand-button[hidden], .rail-button[hidden] { display: none; }
.rail-button { width: 32px; height: 32px; display: grid; place-items: center; padding: 0; border-radius: 8px; background: transparent; color: #d0d0d0; transition: background .16s ease, color .16s ease, transform .16s ease; }
.rail-button svg { width: 17px; height: 17px; }
.rail-button:hover { background: rgba(255,255,255,.075); color: #fff; }
.rail-button:active { transform: scale(.94); }
.rail-button.active { background: rgba(255,255,255,.1); color: #fff; box-shadow: inset 0 0 0 1px rgba(255,255,255,.035); }
.vertical-menu span { width: 3px; height: 3px; border-radius: 50%; background: currentColor; }

/* Browser shell */
.browser-window { grid-area: window; position: relative; z-index: 2; min-width: 0; min-height: 0; margin: 0; display: grid; grid-template-rows: var(--toolbar-h) minmax(0,1fr); overflow: hidden; border-radius: 0; background: var(--toolbar); }
.tab-strip { grid-area: tabs; min-width: 0; height: var(--tabs-h); display: flex; align-items: center; gap: 4px; padding: 0 8px 0 6px; background: var(--tab-strip); user-select: none; -webkit-app-region: drag; }
.tab-zone { min-width: 0; flex: 1; height: 100%; display: flex; align-items: center; gap: 6px; }
.tabstrip-profile-button { -webkit-app-region: no-drag; width: 28px; height: 28px; display: grid; place-items: center; padding: 0; border-radius: 50%; background: transparent; color: #d4d4d4; }
.tabstrip-profile-button:hover { background: rgba(255,255,255,.08); color: #fff; }
.tabstrip-profile-button svg { width: 17px; height: 17px; }
.window-controls[hidden] { display: none; }
.sync-button { position: relative; }
.sync-dot { position: absolute; right: 3px; top: 3px; width: 7px; height: 7px; border-radius: 50%; background: #e05252; }
.tab, .new-tab-button, .window-controls, .browser-toolbar { -webkit-app-region: no-drag; }
.tab { width: 208px; height: 30px; display: grid; grid-template-columns: 16px minmax(0,1fr) 18px; align-items: center; gap: 8px; padding: 0 8px 0 12px; border-radius: 8px; border: 1px solid transparent; background: var(--tab-inactive); color: #cfcfcf; text-align: left; }
.tab:hover { background: #2f2f2f; }
.tab.active, .tab[aria-current="page"] { background: var(--tab-active); border-color: rgba(255,255,255,.09); color: #f5f5f5; }
.tab-favicon { width: 16px; height: 16px; object-fit: contain; border-radius: 4px; }
.tab-title { min-width: 0; overflow: hidden; font-size: 11.5px; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.tab-close { width: 18px; height: 18px; display: grid; place-items: center; border-radius: 5px; color: #b8bbc0; font-size: 15px; }
.tab-close:hover { background: rgba(255,255,255,.1); color: #fff; }
.new-tab-button { width: 28px; height: 28px; display: grid; place-items: center; margin-bottom: 0; padding: 0; border-radius: 50%; background: transparent; color: #d0d0d0; }
.new-tab-button svg { width: 15px; height: 15px; }
.new-tab-button:hover { background: rgba(255,255,255,.07); color: #fff; }
.window-controls { align-self: stretch; display: grid; grid-template-columns: repeat(3,44px); margin-left: auto; }
.window-controls button { display: grid; place-items: center; padding: 0; background: transparent; color: #d0d0d0; font-size: 17px; }
.window-controls button:hover { background: rgba(255,255,255,.08); }
.window-controls button:last-child:hover { background: #d53636; }
.maximize-icon { width: 10px; height: 10px; border: 1px solid currentColor; }

.browser-toolbar { min-width: 0; height: var(--toolbar-h); display: grid; grid-template-columns: minmax(240px,1fr) auto; align-items: center; gap: 10px; padding: 6px 10px 6px 10px; background: var(--toolbar); }
.navigation-controls, .toolbar-actions { display: flex; align-items: center; gap: 1px; }
.tab-strip .navigation-controls { -webkit-app-region: no-drag; margin-right: 6px; gap: 2px; }
.tab-strip .navigation-controls button { width: 27px; height: 27px; display: grid; place-items: center; padding: 0; border-radius: 50%; background: transparent; color: #c5c8cc; }
.tab-strip .navigation-controls button:hover { background: rgba(255,255,255,.08); color: #fff; }
.tab-strip .navigation-controls button:disabled { opacity: .32; }
.tab-strip .navigation-controls svg { width: 15px; height: 15px; }
.tab + .tab { position: relative; }
.new-tab-button { position: relative; margin-left: 6px; }
.new-tab-button::before { content: ""; position: absolute; left: -5px; top: 8px; bottom: 8px; width: 1px; background: rgba(255,255,255,.16); }
.new-tab-button { border-radius: 7px; }
.navigation-controls button, .toolbar-actions button { width: 29px; height: 29px; display: grid; place-items: center; padding: 0; border-radius: 50%; background: transparent; color: #c5c8cc; }
.navigation-controls button:hover, .toolbar-actions button:hover { background: rgba(255,255,255,.075); color: #fff; }
.navigation-controls button:disabled { opacity: .32; }
.navigation-controls svg, .toolbar-actions svg { width: 16px; height: 16px; }
.address-cluster { min-width: 0; display: grid; grid-template-columns: auto minmax(0,1fr); align-items: center; gap: 7px; }
.omnibox { min-width: 0; height: 30px; display: grid; grid-template-columns: 19px minmax(0,1fr) 26px; align-items: center; gap: 4px; margin: 0; padding: 0 4px 0 10px; border-radius: 15px; background: var(--omnibox-bg); box-shadow: none; }
.omnibox:focus-within { box-shadow: 0 0 0 2px var(--blue); }
.omnibox-engine { width: 16px; height: 16px; display: grid; place-items: center; color: #8fb2ff; font-family: Georgia,serif; font-size: 12px; font-weight: 800; }
.omnibox input { width: 100%; min-width: 0; height: 100%; border: 0; outline: 0; background: transparent; color: #f2f2f2; font-size: 12px; }
.omnibox input::placeholder { color: #8f8f8f; }
.omnibox button { width: 26px; height: 26px; display: grid; place-items: center; padding: 0; border-radius: 50%; background: transparent; color: #b9bbc0; }
.omnibox button:hover { background: rgba(255,255,255,.08); color: #fff; }
.omnibox button svg { width: 15px; height: 15px; }
.address-ai-button { width: 30px; height: 30px; display: grid; place-items: center; padding: 0; border: 1px solid rgba(255,255,255,.08); border-radius: 50%; background: #4a4a4a; color: #f5f6f7; }
.address-ai-button:hover { background: #555; border-color: rgba(255,255,255,.15); }
.address-ai-button svg { width: 19px; height: 19px; fill: currentColor; stroke: none; }
.toolbar-actions { gap: 2px; }
.google-account-button { color: #c5c8cc; }
.google-account-button svg { fill: none; stroke: currentColor; stroke-width: 1.7; }
.google-account-button.signed-in { color: #9fbaff; background: rgba(104,143,235,.12); }
.account-status-dot { position: absolute; right: 2px; bottom: 2px; width: 7px; height: 7px; border: 2px solid var(--toolbar); border-radius: 50%; background: #52c779; }
.account-status-dot[hidden] { display: none; }
.ai-history-button { display: none !important; }
body.ai-view .ai-history-button { display: grid !important; color: #c294fa; }
body.ai-view .ai-history-button.active { background: rgba(142,75,225,.18); box-shadow: inset 0 0 0 1px rgba(171,102,255,.25); }
.vertical-menu { display: flex !important; flex-direction: column; gap: 3px; }

/* Current Google-style new tab */
.new-tab-page { position: relative; min-height: 0; overflow: hidden; background: var(--page); }
.page-links { position: absolute; z-index: 2; top: 18px; right: 22px; display: flex; align-items: center; gap: 15px; }
.page-links > button { padding: 3px 0; background: transparent; color: #fff; font-size: 11px; font-weight: 550; }
.page-links > button:hover { text-decoration: underline; }
.apps-grid { width: 24px; height: 24px; display: grid !important; grid-template-columns: repeat(3,3px); grid-template-rows: repeat(3,3px); align-content: center; justify-content: center; gap: 3px; border-radius: 50%; }
.apps-grid:hover { background: rgba(255,255,255,.08) !important; text-decoration: none !important; }
.apps-grid span { width: 3px; height: 3px; border-radius: 50%; background: #e9eaec; }
.hero { position: absolute; left: 50%; top: 42%; width: min(625px,calc(100% - 120px)); display: grid; justify-items: center; transform: translate(-50%,-50%); }
.google-logo { width: 272px; height: 92px; object-fit: contain; margin: 0 0 25px; filter: grayscale(1) brightness(4); }
.hero-search { width: 100%; height: 44px; display: grid; grid-template-columns: 23px minmax(0,1fr) 30px 30px auto; align-items: center; gap: 5px; padding: 0 8px 0 15px; border-radius: 22px; background: #fff; color: #303134; box-shadow: 0 2px 8px rgba(0,0,0,.28); }
.hero-search:focus-within { box-shadow: 0 4px 14px rgba(0,0,0,.3); }
.hero-search-icon { width: 18px; height: 18px; color: #5f6368; stroke-width: 2; }
.hero-search input { width: 100%; min-width: 0; height: 100%; border: 0; outline: 0; background: transparent; color: #202124; font-size: 14px; }
.hero-search input::placeholder { color: #5f6368; }
.hero-search button { height: 31px; display: grid; place-items: center; padding: 0; border-radius: 16px; background: transparent; color: #3c4043; }
.hero-search button:hover { background: rgba(60,64,67,.08); }
.hero-search button svg { width: 19px; height: 19px; }
.ai-mode-button { position: relative; z-index: 0; overflow: visible; grid-template-columns: 17px auto !important; gap: 5px; padding: 0 11px !important; border-radius: 16px !important; color: #315ca8 !important; font-size: 12px; font-weight: 600; white-space: nowrap; background: #fff !important; }
.ai-mode-button::before { content: ""; position: absolute; inset: -2px; z-index: -1; border-radius: 18px; background: linear-gradient(90deg,#4285f4,#9b72cb,#d96570,#fbbc04,#34a853,#4285f4); opacity: .9; }
.ai-mode-button svg { width: 16px !important; height: 16px !important; fill: currentColor; stroke: none; }
.shortcuts { display: flex; justify-content: center; gap: 26px; margin-top: 20px; }
.shortcut { width: 78px; display: grid; justify-items: center; gap: 8px; padding: 9px 4px 7px; border-radius: 8px; background: transparent; color: #f4f4f5; }
.shortcut:hover { background: rgba(255,255,255,.06); }
.shortcut-disc { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: #4a4a4a; color: #fff; }
.shortcut > span:last-child { max-width: 75px; overflow: hidden; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
.shortcut-plus { font-size: 24px; font-weight: 300; }
.store-bag { position: relative; width: 21px; height: 18px; border-radius: 3px; background: linear-gradient(145deg,#9fc0ff,#dce9ff 47%,#538af3 48%); box-shadow: inset 0 0 0 1px rgba(0,0,0,.15); }
.store-bag::before { content:""; position:absolute; left:6px; top:-6px; width:9px; height:7px; border:2px solid #eff5ff; border-bottom:0; border-radius:7px 7px 0 0; }
.store-bag i { position:absolute; left:8px; top:7px; width:6px; height:6px; border-radius:50%; background:conic-gradient(#e74a3b 0 25%,#fbbc04 0 50%,#34a853 0 75%,#4285f4 0); }

.google-account-popover { position: absolute; z-index: 55; top: 83px; right: 54px; width: 315px; padding: 14px; border: 1px solid rgba(255,255,255,.1); border-radius: 16px; background: rgba(31,32,34,.98); box-shadow: 0 18px 60px rgba(0,0,0,.48); backdrop-filter: blur(20px); }
.google-account-popover > header { display: grid; grid-template-columns: 37px minmax(0,1fr) 26px; align-items: center; gap: 10px; margin-bottom: 13px; }
.google-account-popover > header > div:nth-child(2) { min-width: 0; display: grid; gap: 3px; }
.google-account-popover > header strong { overflow: hidden; color: #f4f5f7; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.google-account-popover > header span { color: #999ca2; font-size: 9px; }
.google-account-popover > header > button { width: 26px; height: 26px; border-radius: 50%; background: transparent; color: #c9cbd0; font-size: 19px; }
.google-account-avatar { width: 37px; height: 37px; display: grid; place-items: center; border-radius: 50%; background: #292b2f; color: #afb2b9; }
.google-account-avatar svg { width: 21px; fill: none; stroke: currentColor; stroke-width: 1.6; }
.google-account-save-status { display: grid; grid-template-columns: 24px minmax(0,1fr); gap: 9px; padding: 11px; border: 1px solid rgba(255,255,255,.065); border-radius: 11px; background: #252629; }
.google-account-save-status .save-status-icon { width: 22px; height: 22px; display: grid; place-items: center; border-radius: 50%; background: rgba(70,191,112,.15); color: #70d394; font-size: 11px; }
.google-account-save-status div { display: grid; gap: 4px; }
.google-account-save-status strong { color: #e9eaec; font-size: 10px; }
.google-account-save-status small { color: #96999f; font-size: 8px; line-height: 1.4; }
.google-sign-in-button, .google-sign-out-button { width: 100%; min-height: 37px; margin-top: 10px; display: flex; align-items: center; justify-content: center; gap: 8px; border-radius: 10px; }
.google-sign-in-button { background: #f4f5f7; color: #242529; font-size: 10px; font-weight: 650; }
.google-sign-in-button:hover { background: #fff; }
.google-sign-in-button svg { width: 17px; stroke: none; }
.google-sign-in-button svg path:nth-child(1) { fill: #4285f4; }.google-sign-in-button svg path:nth-child(2) { fill: #34a853; }.google-sign-in-button svg path:nth-child(3) { fill: #fbbc05; }.google-sign-in-button svg path:nth-child(4) { fill: #ea4335; }
.google-sign-out-button { background: transparent; color: #d6d8dc; border: 1px solid rgba(255,255,255,.08); font-size: 10px; }
.google-sign-in-button[hidden], .google-sign-out-button[hidden] { display: none; }
.google-sync-note { margin: 11px 3px 0; color: #8d9096; font-size: 8px; line-height: 1.45; }.google-sync-note strong { color: #b9bcc2; }
.settings-popover { position:absolute; z-index:50; right:18px; bottom:18px; width:270px; padding:15px; border:1px solid rgba(255,255,255,.1); border-radius:17px; background:rgba(31,32,34,.97); box-shadow:0 18px 60px rgba(0,0,0,.45); backdrop-filter:blur(18px); }
.settings-popover header { display:flex; justify-content:space-between; align-items:start; margin-bottom:14px; }
.settings-popover header div { display:grid; gap:3px; }
.settings-popover strong { font-size:14px; }
.settings-popover header span { color:#9ea1a7; font-size:11px; }
.settings-popover header button { width:25px; height:25px; border-radius:50%; background:transparent; color:#d7d8db; font-size:20px; }
.settings-popover label { display:flex; justify-content:space-between; align-items:center; min-height:38px; border-top:1px solid rgba(255,255,255,.08); color:#e6e7e9; font-size:12px; }
.toast { position:absolute; z-index:80; left:calc(50% + var(--rail-w)/2); bottom:22px; transform:translateX(-50%); padding:9px 14px; border:1px solid rgba(255,255,255,.08); border-radius:999px; background:rgba(19,20,22,.94); color:#f5f6f7; font-size:12px; box-shadow:0 12px 35px rgba(0,0,0,.35); }

@media (max-width:800px) {
  :root { --rail-w:44px; }
  .window-controls { display:none; }
  .toolbar-actions button:nth-child(-n+2) { display:none; }
  .hero { width:calc(100% - 58px); }
  .google-logo { width:230px; height:auto; }
  .address-ai-button span, .ai-mode-button span { display:none; }
  .address-ai-button, .ai-mode-button { width:30px; padding:0 5px !important; }
}
@media (max-height:560px) {
  .hero { top:47%; }
  .google-logo { width:220px; height:auto; margin-bottom:18px; }
  .shortcuts { margin-top:13px; }
}

/* Functional browser layer */
.tabs { min-width: 0; max-width: calc(100vw - 280px); height: 100%; display: flex; align-items: end; gap: 3px; overflow: hidden; }
.tabs .tab { flex: 0 1 208px; min-width: 96px; max-width: 224px; }
.tabs .tab:not(.active):hover { background: #2f2f2f; }
.browser-stage { position: relative; min-height: 0; overflow: hidden; background: var(--page); border-radius: 8px 8px 0 0; margin: 0 4px 0 0; }
.new-tab-page, .webview-layer, .webview-layer webview { position: absolute; inset: 0; width: 100%; height: 100%; }
.new-tab-page[hidden] { display: none; }
.webview-layer { z-index: 2; pointer-events: none; background: #fff; }
.webview-layer:not(.active) { display: none; }
.webview-layer.active { pointer-events: auto; }
.webview-layer webview { display: none; border: 0; background: #fff; }
.webview-layer webview.active { display: flex; }
.load-progress { position: absolute; z-index: 15; left: 0; right: 0; top: 0; height: 2px; opacity: 0; transform: scaleX(0); transform-origin: left; background: #86a8ff; pointer-events: none; }
.page-loading .load-progress { opacity: 1; animation: loadProgress 2.2s ease-in-out infinite; }
@keyframes loadProgress { 0% { transform: scaleX(.04); } 55% { transform: scaleX(.68); } 100% { transform: scaleX(.96); } }
.stop-icon { display: none; }
.page-loading .reload-icon { display: none; }
.page-loading .stop-icon { display: block; }
#bookmarkButton.active { color: #e6b95f; }
#bookmarkButton.active svg { fill: currentColor; }
.download-badge { position: absolute; top: 3px; right: 3px; width: 6px; height: 6px; border-radius: 50%; background: #87a8ff; box-shadow: 0 0 0 2px var(--toolbar); }
.toolbar-actions button { position: relative; }
.shortcut { position: relative; }
.shortcut-remove { position: absolute; top: 3px; right: 4px; width: 18px; height: 18px; display: none; place-items: center; border-radius: 50%; background: rgba(19,20,22,.85); color: #fff; font-style: normal; font-size: 13px; }
.shortcut:hover .shortcut-remove { display: grid; }
.custom-disc { font-size: 15px; font-weight: 750; background: #46484c; }

.side-panel { position: absolute; z-index: 70; top: 12px; right: 12px; bottom: 12px; width: min(360px, calc(100vw - 92px)); display: grid; grid-template-rows: auto 1fr auto; border: 1px solid rgba(255,255,255,.1); border-radius: 18px; background: rgba(27,28,30,.98); box-shadow: 0 24px 80px rgba(0,0,0,.48); backdrop-filter: blur(20px); overflow: hidden; }
.side-panel[hidden], .popover[hidden], .find-bar[hidden] { display: none; }
.side-panel header, .popover header { display: flex; align-items: center; justify-content: space-between; padding: 14px; border-bottom: 1px solid rgba(255,255,255,.075); }
.side-panel header > div { display: flex; align-items: center; gap: 9px; }
.side-panel header img { width: 27px; height: 24px; object-fit: contain; }
.side-panel header span { display: grid; gap: 1px; }
.side-panel header small { color: #9da0a5; font-size: 10px; }
.side-panel header button, .popover header button { width: 26px; height: 26px; border-radius: 50%; background: transparent; color: #d9dade; font-size: 20px; }
.side-panel header button:hover, .popover header button:hover { background: rgba(255,255,255,.08); }
.ai-content { min-height: 0; overflow: auto; padding: 15px; }
.ai-content > p { margin: 0 0 12px; color: #b9bbc0; font-size: 12px; line-height: 1.5; }
.context-card { max-height: 320px; overflow: auto; padding: 12px; border: 1px solid rgba(255,255,255,.07); border-radius: 13px; background: #212225; color: #d7d9dc; font-size: 11px; line-height: 1.55; white-space: pre-wrap; }
.ai-content > button, .panel-action { width: 100%; height: 34px; margin-top: 10px; border-radius: 10px; background: #34363a; color: #f4f5f6; font-size: 11px; font-weight: 650; }
.ai-content > button:hover, .panel-action:hover { background: #404247; }
#aiForm { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 8px; padding: 12px; border-top: 1px solid rgba(255,255,255,.075); }
#aiForm textarea { resize: none; min-height: 42px; padding: 9px 10px; border: 1px solid rgba(255,255,255,.08); border-radius: 12px; outline: 0; background: #202124; color: #fff; font: inherit; font-size: 11px; }
#aiForm button { align-self: end; height: 34px; padding: 0 13px; border-radius: 10px; background: #e8eaed; color: #202124; font-size: 11px; font-weight: 700; }

.popover { position: absolute; z-index: 65; right: 14px; width: 285px; padding: 7px; border: 1px solid rgba(255,255,255,.1); border-radius: 15px; background: rgba(31,32,34,.98); box-shadow: 0 18px 60px rgba(0,0,0,.45); backdrop-filter: blur(18px); }
.settings-popover { top: auto; right: auto; bottom: 14px; left: 70px; width: 285px; }
.settings-popover header, .list-popover header { margin: -7px -7px 7px; }
.settings-popover header div { display: grid; gap: 3px; }
.settings-popover header span { color: #9ea1a7; font-size: 10px; }
.settings-popover label { display: flex; justify-content: space-between; align-items: center; min-height: 39px; padding: 0 7px; border-top: 1px solid rgba(255,255,255,.07); color: #e5e6e8; font-size: 11px; }
.menu-popover { top: 83px; }
.menu-popover > button { width: 100%; height: 34px; display: flex; align-items: center; justify-content: space-between; padding: 0 10px; border-radius: 9px; background: transparent; color: #e8e9eb; font-size: 11px; text-align: left; }
.menu-popover > button:hover { background: rgba(255,255,255,.075); }
kbd { color: #8f9297; font: inherit; font-size: 10px; }
.list-popover { top: 83px; max-height: min(440px, calc(100vh - 110px)); overflow: hidden; }
#bookmarksPopover { right: 76px; }
#downloadsPopover { right: 44px; }
#bookmarksList, #downloadsList { max-height: 360px; overflow: auto; }
.list-item { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 6px; }
.list-item > button:first-child { min-width: 0; min-height: 47px; display: grid; align-content: center; gap: 3px; padding: 6px 9px; border-radius: 9px; background: transparent; color: #eceef0; text-align: left; }
.list-item > button:first-child:hover { background: rgba(255,255,255,.065); }
.list-item strong, .list-item small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.list-item strong { font-size: 11px; }
.list-item small { color: #92959a; font-size: 9px; }
.list-remove { width: 25px; height: 25px; border-radius: 50%; background: transparent; color: #a9acb1; font-size: 17px; }
.list-remove:hover { background: rgba(255,255,255,.08); color: #fff; }
.empty-list { margin: 20px 10px; color: #989ba0; font-size: 11px; text-align: center; }

.find-bar { position: absolute; z-index: 35; top: 8px; right: 8px; height: 35px; display: grid; grid-template-columns: minmax(0,180px) auto repeat(3,28px); align-items: center; gap: 4px; padding: 4px; border: 1px solid rgba(255,255,255,.1); border-radius: 10px; background: #242528; color: #eff0f2; box-shadow: 0 8px 25px rgba(0,0,0,.35); }
.find-bar input { height: 27px; border: 0; outline: 0; padding: 0 7px; background: transparent; color: #fff; font-size: 11px; }
.find-bar span { color: #9da0a5; font-size: 9px; }
.find-bar button { width: 28px; height: 27px; border-radius: 7px; background: transparent; color: #d4d6d9; }
.find-bar button:hover { background: rgba(255,255,255,.08); }
/* Corv AI view — standalone VShell approval pass */
.page-stage { position: relative; min-height: 0; overflow: hidden; background: #0c0d0f; }
.page-stage > section { position: absolute; inset: 0; }
.page-stage > section[hidden] { display: none; }
.rail-primary { gap: 10px; }
.ai-rail-button svg { width: 19px; height: 19px; fill: currentColor; stroke: none; }
.ai-rail-button.active { background: #17121f; color: #c08aff; box-shadow: inset 0 0 0 1px rgba(154,82,255,.55), 0 0 18px rgba(116,51,210,.2); }
.home-rail-button.active { background: rgba(255,255,255,.1); color: #fff; }
body.ai-view .address-ai-button { border-color: rgba(143,71,255,.54); background: #21152e; color: #c899ff; box-shadow: 0 0 16px rgba(117,48,223,.18); }
body.ai-view .omnibox-engine { color: #fff; }
.tab-ai-favicon { display: grid; place-items: center; color: #b06dff; font-size: 13px; }
body:not(.ai-view) .tab-ai-favicon { color: #d9dadd; }

.corv-ai-page { overflow: auto; background: radial-gradient(circle at 48% 18%, rgba(91,32,156,.07), transparent 34%), #0d0e10; color: #f7f5fa; }
.ai-workspace { width: min(696px, calc(100% - 76px)); margin: 0 auto; padding: 54px 0 45px; }
.ai-hero { display: grid; justify-items: center; margin-bottom: 28px; }
.ai-hero h1 { display: flex; align-items: center; gap: 6px; margin: 0; font-size: 30px; line-height: 1; font-weight: 620; letter-spacing: -.8px; }
.ai-hero h1 em { color: #a858ff; font-style: normal; font-weight: 650; }
.ai-sparkles { margin-right: 2px; color: #9d4dff; font-size: 29px; text-shadow: 0 0 16px rgba(143,65,255,.66); }
.ai-hero p { margin: 12px 0 0; color: #aaa7af; font-size: 11px; }
.ai-composer { height: 120px; display: grid; grid-template-rows: minmax(0,1fr) auto; padding: 14px 15px 12px; border: 1px solid rgba(255,255,255,.055); border-radius: 18px; background: linear-gradient(145deg, #151419, #111216); box-shadow: 0 12px 35px rgba(0,0,0,.2), inset 0 1px rgba(255,255,255,.015); }
.ai-composer textarea { width: 100%; resize: none; border: 0; outline: 0; padding: 0; background: transparent; color: #f4f2f7; font: inherit; font-size: 12px; line-height: 1.5; }
.ai-composer textarea::placeholder { color: #b0adb5; }
.ai-composer footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.ai-tools, .ai-submit-controls { display: flex; align-items: center; gap: 7px; }
.ai-tools button { height: 28px; display: flex; align-items: center; gap: 6px; padding: 0 10px; border: 1px solid rgba(255,255,255,.075); border-radius: 8px; background: rgba(255,255,255,.015); color: #dbd8df; font-size: 10px; }
.ai-tools button:hover, .ai-prompts button:hover { border-color: rgba(174,108,255,.3); background: rgba(139,71,228,.08); }
.ai-tools button span { font-size: 14px; }
.ai-submit-controls button { display: grid; place-items: center; padding: 0; border-radius: 50%; }
.ai-mic { width: 29px; height: 29px; background: transparent; color: #c1bec6; }
.ai-mic svg { width: 16px; height: 16px; stroke-width: 1.8; }
.ai-mic:hover { background: rgba(255,255,255,.05); }
.ai-send { width: 34px; height: 34px; background: linear-gradient(145deg,#9c4dff,#722ee4); color: #fff; font-size: 21px; box-shadow: 0 5px 18px rgba(117,44,225,.36); }
.ai-send:hover { filter: brightness(1.08); }
.ai-prompts { display: grid; grid-template-columns: 1.12fr 1.05fr 1fr .96fr auto; gap: 8px; margin-top: 23px; }
.ai-prompts button { min-width: 0; height: 37px; display: flex; align-items: center; justify-content: center; gap: 7px; padding: 0 11px; border: 1px solid rgba(255,255,255,.07); border-radius: 9px; background: #111216; color: #e2dfe5; font-size: 10px; white-space: nowrap; }
.ai-prompts button span { color: #d9d5df; font-size: 14px; }
.ai-prompts .more-prompt { min-width: 70px; padding-inline: 12px; }
.ai-prompts .more-prompt span { font-size: 11px; }
.recent-chats { margin: 47px auto 0; width: calc(100% - 52px); }
.recent-chats > header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; color: #908d95; font-size: 10px; }
.recent-chats > header button { padding: 3px 0; background: transparent; color: #9a5af1; font-size: 9px; }
.recent-chat { width: 100%; height: 42px; display: grid; grid-template-columns: 20px minmax(0,1fr) auto; align-items: center; gap: 8px; padding: 0 12px; border-top: 1px solid rgba(255,255,255,.018); background: linear-gradient(90deg, rgba(255,255,255,.025), rgba(255,255,255,.012)); color: #e7e4e9; text-align: left; }
.recent-chat:hover { background: rgba(255,255,255,.045); }
.recent-chat strong { overflow: hidden; font-size: 10px; font-weight: 520; text-overflow: ellipsis; white-space: nowrap; }
.recent-chat time { color: #8d8992; font-size: 9px; }
.recent-chat > span { color: #d3cfd8; font-size: 14px; }
.ai-history-panel { position: absolute; z-index: 8; top: 12px; right: 12px; bottom: 12px; width: min(350px, calc(100% - 24px)); display: grid; grid-template-rows: auto auto minmax(0,1fr); gap: 13px; padding: 17px 14px 12px; border: 1px solid rgba(255,255,255,.09); border-radius: 16px; background: rgba(19,19,23,.97); box-shadow: 0 20px 55px rgba(0,0,0,.5), inset 0 1px rgba(255,255,255,.025); backdrop-filter: blur(24px); }
.ai-history-panel[hidden] { display: none; }
.ai-history-panel > header { display: flex; align-items: center; justify-content: space-between; padding: 0 3px; }
.ai-history-panel > header div { display: grid; gap: 3px; }
.ai-history-panel > header strong { color: #f5f2f7; font-size: 13px; }
.ai-history-panel > header span { color: #89858e; font-size: 9px; }
.ai-history-panel > header button { width: 28px; height: 28px; border-radius: 50%; background: transparent; color: #b7b3bc; font-size: 19px; }
.ai-history-panel > header button:hover { background: rgba(255,255,255,.07); color: #fff; }
.ai-history-search { height: 34px; display: grid; grid-template-columns: 20px minmax(0,1fr); align-items: center; gap: 5px; padding: 0 10px; border: 1px solid rgba(255,255,255,.065); border-radius: 10px; background: #101115; }
.ai-history-search svg { width: 15px; color: #88848d; }
.ai-history-search input { min-width: 0; border: 0; outline: 0; background: transparent; color: #ece9ef; font-size: 10px; }
.ai-history-search input::placeholder { color: #77747d; }
.ai-history-list { min-height: 0; overflow: auto; padding-right: 2px; }
.ai-history-list > p { margin: 12px 8px 6px; color: #75717b; font-size: 9px; }
.ai-history-list > p:first-child { margin-top: 2px; }
.history-chat { width: 100%; min-height: 45px; display: grid; grid-template-columns: 20px minmax(0,1fr); grid-template-rows: auto auto; align-items: center; gap: 2px 8px; padding: 8px 9px; border-radius: 9px; background: transparent; color: #e7e3ea; text-align: left; }
.history-chat:hover { background: rgba(255,255,255,.055); }
.history-chat > span { grid-row: 1 / 3; color: #aaa5af; font-size: 14px; }
.history-chat strong { overflow: hidden; font-size: 10px; font-weight: 530; text-overflow: ellipsis; white-space: nowrap; }
.history-chat time { color: #76727b; font-size: 8px; }

@media (max-width: 850px) {
  .ai-workspace { width: calc(100% - 38px); padding-top: 38px; }
  .ai-prompts { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .ai-prompts button:last-child { display: none; }
  .recent-chats { margin-top: 28px; width: 100%; }
}
@media (max-height: 600px) {
  .ai-workspace { padding-top: 26px; }
  .ai-hero { margin-bottom: 18px; }
  .recent-chats { margin-top: 25px; }
}
.corv-ai-page { position: absolute; inset: 0; z-index: 3; }
.corv-ai-page[hidden] { display: none; }
body.ai-view .browser-window { grid-template-rows: var(--tabs-h) var(--toolbar-h) minmax(0,1fr); }
body.ai-view .browser-toolbar { display: grid; }
body.ai-view .browser-stage { grid-row: 3; }
body.ai-view .corv-ai-page { border-top: 1px solid rgba(255,255,255,.025); }

/* ---------- Spaces ---------- */
.space-rail { display: grid; justify-items: center; gap: 8px; margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,.09); }
.space-button { position: relative; width: 32px; height: 32px; display: grid; place-items: center; padding: 0; border-radius: 10px; background: transparent; font-size: 15px; line-height: 1; transition: background .16s ease, transform .16s ease; }
.space-button:hover { background: rgba(255,255,255,.08); }
.space-button:active { transform: scale(.92); }
.space-button.active { background: rgba(255,255,255,.1); box-shadow: inset 0 0 0 1.5px var(--sc, #6f9df1); }
.space-button.active::before { content: ""; position: absolute; left: -7px; top: 8px; bottom: 8px; width: 3px; border-radius: 2px; background: var(--sc, #6f9df1); }
.space-add { width: 28px; height: 28px; display: grid; place-items: center; padding: 0; border-radius: 9px; background: transparent; color: #a9a9a9; font-size: 17px; font-weight: 300; transition: background .16s ease, color .16s ease; }
.space-add:hover { background: rgba(255,255,255,.08); color: #fff; }
.rail-secondary .rail-app img { width: 20px; height: 20px; border-radius: 5px; object-fit: contain; }
.rail-app { cursor: grab; }
.rail-app:active { cursor: grabbing; }
.rail-add-app { color: #a9a9a9; }

/* Space switch animation */
.space-switch .browser-window { animation: spaceFade .26s ease; }
@keyframes spaceFade { from { opacity: .35; transform: translateY(4px); } to { opacity: 1; transform: none; } }

/* App library */
.app-library-popover { left: 56px; bottom: 14px; top: auto; right: auto; width: 320px; max-height: 430px; display: flex; flex-direction: column; }
.app-library-popover header { display: flex; align-items: center; justify-content: space-between; }
.app-library-popover header span { display: block; color: #9a9a9a; font-size: 11px; }
.app-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin: 10px 0; overflow-y: auto; }
.app-cell { position: relative; display: grid; justify-items: center; gap: 5px; padding: 9px 2px 7px; border-radius: 9px; background: transparent; transition: background .15s ease; }
.app-cell:hover { background: rgba(255,255,255,.07); }
.app-cell img { width: 22px; height: 22px; border-radius: 5px; }
.app-cell span { max-width: 100%; overflow: hidden; color: #cfcfcf; font-size: 9.5px; text-overflow: ellipsis; white-space: nowrap; }
.app-cell.added { background: rgba(111,157,241,.12); }
.app-cell.added i { position: absolute; right: 5px; top: 4px; color: #8fb2ff; font-size: 10px; font-style: normal; }

/* Space modal (templates) */
.space-modal { position: fixed; inset: 0; z-index: 60; display: grid; place-items: center; background: rgba(0,0,0,.55); backdrop-filter: blur(3px); animation: modalIn .18s ease; }
.space-modal[hidden] { display: none; }
@keyframes modalIn { from { opacity: 0; } to { opacity: 1; } }
.space-modal-card { width: min(680px, calc(100vw - 60px)); max-height: calc(100vh - 90px); overflow-y: auto; padding: 18px 20px 20px; border: 1px solid rgba(255,255,255,.1); border-radius: 16px; background: #303030; box-shadow: 0 24px 70px rgba(0,0,0,.5); animation: cardIn .22s cubic-bezier(.2,.9,.3,1.2); }
@keyframes cardIn { from { opacity: 0; transform: scale(.96) translateY(8px); } to { opacity: 1; transform: none; } }
.space-modal-card header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 14px; }
.space-modal-card header strong { font-size: 15px; }
.space-modal-card header span { display: block; margin-top: 2px; color: #9a9a9a; font-size: 11.5px; }
.space-modal-card header button { width: 26px; height: 26px; border-radius: 50%; background: transparent; color: #bbb; font-size: 16px; }
.space-modal-card header button:hover { background: rgba(255,255,255,.08); color: #fff; }
.template-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }
.template-card { display: grid; justify-items: start; gap: 4px; padding: 13px 13px 11px; border: 1px solid rgba(255,255,255,.08); border-radius: 12px; background: rgba(255,255,255,.03); text-align: left; transition: background .16s ease, border-color .16s ease, transform .16s ease; }
.template-card:hover { background: rgba(255,255,255,.07); border-color: rgba(255,255,255,.18); transform: translateY(-1px); }
.template-icon { font-size: 20px; }
.template-card strong { color: #f0f0f0; font-size: 12.5px; }
.template-card small { color: #9a9a9a; font-size: 10.5px; }
.template-apps { display: flex; gap: 4px; margin-top: 6px; min-height: 14px; }
.template-apps img { width: 13px; height: 13px; border-radius: 3px; }

/* Context menu */
.context-menu { position: fixed; z-index: 70; min-width: 172px; padding: 5px; border: 1px solid rgba(255,255,255,.1); border-radius: 10px; background: #333; box-shadow: 0 14px 40px rgba(0,0,0,.45); animation: menuIn .12s ease; }
.context-menu[hidden] { display: none; }
@keyframes menuIn { from { opacity: 0; transform: scale(.97); } to { opacity: 1; transform: none; } }
.context-menu button { width: 100%; display: block; padding: 7px 10px; border-radius: 7px; background: transparent; color: #e4e4e4; font-size: 12px; text-align: left; }
.context-menu button:hover { background: rgba(255,255,255,.09); }
.context-menu button.danger { color: #f08a8a; }
.context-menu button.danger:hover { background: rgba(224,82,82,.14); }
.menu-colors { display: flex; gap: 6px; padding: 7px 10px; }
.menu-colors button { width: 17px; height: 17px; padding: 0; border-radius: 50%; border: 1.5px solid rgba(255,255,255,.25); }
.menu-colors button:hover { transform: scale(1.15); }

/* ---------- In-app dialogs ---------- */
.dialog-card { width: min(400px, calc(100vw - 80px)); padding: 18px 20px 16px; border: 1px solid rgba(255,255,255,.1); border-radius: 14px; background: #303030; box-shadow: 0 24px 70px rgba(0,0,0,.5); animation: cardIn .2s cubic-bezier(.2,.9,.3,1.2); }
.dialog-card strong { display: block; font-size: 14.5px; color: #f2f2f2; }
.dialog-card p { margin: 4px 0 0; color: #9a9a9a; font-size: 11.5px; }
.dialog-fields { display: grid; gap: 10px; margin-top: 14px; }
.dialog-fields[hidden] { display: none; }
.dialog-fields label { display: grid; gap: 4px; }
.dialog-fields label span { color: #b5b5b5; font-size: 10.5px; font-weight: 550; text-transform: uppercase; letter-spacing: .4px; }
.dialog-fields input { height: 32px; padding: 0 10px; border: 1px solid rgba(255,255,255,.12); border-radius: 8px; background: #262626; color: #f2f2f2; font-size: 12.5px; outline: none; }
.dialog-fields input:focus { border-color: var(--blue); box-shadow: 0 0 0 2px rgba(111,157,241,.25); }
.dialog-card footer { display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; }
.dialog-card footer button { height: 30px; padding: 0 14px; border-radius: 8px; background: rgba(255,255,255,.07); color: #ddd; font-size: 12px; font-weight: 550; }
.dialog-card footer button:hover { background: rgba(255,255,255,.12); }
.dialog-card footer button.primary { background: var(--blue); color: #fff; }
.dialog-card footer button.primary:hover { filter: brightness(1.1); }
.dialog-card footer button.primary.danger { background: #d64545; }

/* ---------- Expandable rail ---------- */
.rail-label { display: none; min-width: 0; overflow: hidden; color: #d6d6d6; font-size: 11.5px; font-weight: 550; text-align: left; text-overflow: ellipsis; white-space: nowrap; }
.rail-expanded .vshell { grid-template-columns: 196px minmax(0,1fr); }
.rail-expanded .app-rail { width: 196px; align-items: stretch; padding: 8px 8px 10px; }
.rail-expanded .avatar-button { justify-self: start; margin-left: 2px; }
.rail-expanded .rail-label { display: block; flex: 1; }
.rail-expanded .space-rail, .rail-expanded .rail-secondary { justify-items: stretch; }
.rail-expanded .space-button, .rail-expanded .space-add, .rail-expanded .rail-button { width: 100%; height: 34px; display: flex; align-items: center; gap: 10px; padding: 0 9px; border-radius: 9px; }
.rail-expanded .space-button.active::before { left: -8px; }
.rail-expanded .space-emoji { font-size: 15px; }
.rail-expanded .rail-secondary .rail-app img { width: 18px; height: 18px; }
.app-rail, .vshell { transition: none; }

/* ---------- Space icon squares ---------- */
.space-icon-square { width: 24px; height: 24px; display: grid; place-items: center; border-radius: 7px; background: var(--sc, #6f9df1); color: #fff; flex: none; }
.space-icon-square svg { width: 14px; height: 14px; stroke-width: 1.9; }
.space-button { font-size: 0; }
.space-button .space-emoji { font-size: 13px; }

/* ---------- New Space dialog ---------- */
.new-space-card { position: relative; display: flex; gap: 22px; width: min(560px, calc(100vw - 70px)); padding: 22px 24px 20px; border: 1px solid rgba(255,255,255,.1); border-radius: 14px; background: #262626; box-shadow: 0 24px 70px rgba(0,0,0,.5); animation: cardIn .22s cubic-bezier(.2,.9,.3,1.2); }
.modal-close { position: absolute; right: 12px; top: 12px; width: 26px; height: 26px; border-radius: 50%; background: transparent; color: #bbb; font-size: 16px; }
.modal-close:hover { background: rgba(255,255,255,.08); color: #fff; }
.space-preview { display: grid; justify-items: center; align-content: start; gap: 8px; padding: 14px 10px; border-radius: 12px; background: #1f1f1f; border: 1px solid rgba(255,255,255,.07); }
.space-preview small { color: #8a8a8a; font-size: 10px; text-transform: uppercase; letter-spacing: .5px; }
.preview-rail { display: grid; justify-items: center; gap: 10px; width: 44px; padding: 12px 0; border-radius: 10px; background: #404040; min-height: 150px; }
.preview-space-icon { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 8px; color: #fff; }
.preview-space-icon svg { width: 15px; height: 15px; }
.preview-apps { display: grid; gap: 8px; }
.preview-apps img { width: 18px; height: 18px; border-radius: 5px; }
.new-space-fields { flex: 1; min-width: 0; display: grid; gap: 13px; align-content: start; }
.new-space-fields h2 { margin: 0; font-size: 15px; font-weight: 650; color: #f2f2f2; }
.field-block { display: grid; gap: 6px; }
.field-block > span { color: #b5b5b5; font-size: 10.5px; font-weight: 550; text-transform: uppercase; letter-spacing: .4px; }
.field-block input { height: 32px; padding: 0 10px; border: 1px solid rgba(255,255,255,.12); border-radius: 8px; background: #1f1f1f; color: #f2f2f2; font-size: 12.5px; outline: none; }
.field-block input:focus { border-color: var(--blue); box-shadow: 0 0 0 2px rgba(111,157,241,.25); }
.look-row { display: flex; gap: 8px; }
.look-row button { width: 20px; height: 20px; padding: 0; border-radius: 50%; border: 2px solid transparent; transition: transform .14s ease; }
.look-row button:hover { transform: scale(1.15); }
.look-row button.selected { border-color: #fff; box-shadow: 0 0 0 2px rgba(255,255,255,.2); }
.icon-strip { display: flex; flex-wrap: wrap; gap: 4px; }
.icon-strip button { width: 30px; height: 30px; display: grid; place-items: center; padding: 0; border-radius: 8px; background: transparent; color: #cfcfcf; }
.icon-strip button svg { width: 16px; height: 16px; }
.icon-strip button:hover { background: rgba(255,255,255,.08); color: #fff; }
.icon-strip button.selected { background: rgba(255,255,255,.14); color: #fff; }
.start-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.start-chip { display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 8px; border-radius: 13px; background: #333; color: #ddd; font-size: 11.5px; }
.start-chip img { width: 14px; height: 14px; border-radius: 4px; }
.start-chip button { width: 15px; height: 15px; display: grid; place-items: center; padding: 0; border-radius: 50%; background: transparent; color: #999; font-size: 12px; }
.start-chip button:hover { background: rgba(255,255,255,.12); color: #fff; }
.start-chip.add-chip { background: transparent; border: 1px dashed rgba(255,255,255,.25); color: #a9a9a9; cursor: pointer; }
.start-chip.add-chip:hover { border-color: rgba(255,255,255,.45); color: #fff; }
.new-space-fields footer { display: flex; justify-content: flex-end; gap: 10px; margin-top: 4px; }
.text-button { padding: 6px 10px; border-radius: 8px; background: transparent; color: #b9b9b9; font-size: 12px; }
.text-button:hover { background: rgba(255,255,255,.07); color: #fff; }
.primary-button { height: 30px; padding: 0 16px; border-radius: 8px; background: var(--blue); color: #fff; font-size: 12px; font-weight: 550; }
.primary-button:hover { filter: brightness(1.1); }

/* ---------- App picker ---------- */
.app-picker { position: fixed; inset: 0; z-index: 55; display: grid; place-items: center; background: rgba(0,0,0,.55); backdrop-filter: blur(3px); animation: modalIn .18s ease; }
.app-picker[hidden] { display: none; }
.app-picker-card { display: flex; flex-direction: column; width: min(620px, calc(100vw - 70px)); max-height: calc(100vh - 110px); padding: 18px 20px 14px; border: 1px solid rgba(255,255,255,.1); border-radius: 14px; background: #262626; box-shadow: 0 24px 70px rgba(0,0,0,.5); animation: cardIn .22s cubic-bezier(.2,.9,.3,1.2); }
.app-picker-card header { display: flex; align-items: center; gap: 12px; }
.app-picker-card header strong { font-size: 15px; color: #f2f2f2; }
.app-picker-card header span { display: block; color: #9a9a9a; font-size: 11px; }
.app-picker-card header > div { flex: 1; min-width: 0; }
.app-search { display: flex; align-items: center; gap: 6px; height: 30px; padding: 0 10px; border: 1px solid rgba(255,255,255,.12); border-radius: 15px; background: #1f1f1f; }
.app-search svg { width: 13px; height: 13px; color: #9a9a9a; flex: none; }
.app-search input { width: 150px; border: 0; outline: 0; background: transparent; color: #f2f2f2; font-size: 12px; }
.app-picker-card header > button { width: 26px; height: 26px; border-radius: 50%; background: transparent; color: #bbb; font-size: 16px; flex: none; }
.app-picker-card header > button:hover { background: rgba(255,255,255,.08); color: #fff; }
.app-category-tabs { display: flex; gap: 4px; margin: 12px 0 10px; }
.app-category-tabs button { height: 26px; padding: 0 12px; border-radius: 13px; background: transparent; color: #b5b5b5; font-size: 11.5px; }
.app-category-tabs button:hover { background: rgba(255,255,255,.07); color: #fff; }
.app-category-tabs button.active { background: rgba(255,255,255,.13); color: #fff; }
.app-picker-card .app-grid { grid-template-columns: repeat(6, 1fr); gap: 6px; margin: 0 0 10px; overflow-y: auto; }
.app-picker-card .app-cell { background: #303030; padding: 12px 4px 9px; }
.app-picker-card .app-cell:hover { background: #3a3a3a; }
.app-picker-card .app-cell img { width: 24px; height: 24px; }
.app-picker-card .app-cell .add-badge { position: absolute; right: 5px; top: 4px; color: #9a9a9a; font-size: 11px; font-style: normal; opacity: 0; transition: opacity .12s ease; }
.app-picker-card .app-cell:hover .add-badge { opacity: 1; }
.app-picker-card footer { display: flex; align-items: center; justify-content: space-between; padding-top: 10px; border-top: 1px solid rgba(255,255,255,.08); }

/* ---------- Omnibox suggestions ---------- */
.omnibox { position: relative; }
.omnibox-suggestions { position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 60; display: grid; padding: 6px; border: 1px solid rgba(255,255,255,.1); border-radius: 12px; background: #2e2e2e; box-shadow: 0 18px 50px rgba(0,0,0,.45); }
.omnibox-suggestions button { display: flex; align-items: center; gap: 10px; width: 100%; height: 34px; padding: 0 10px; border-radius: 8px; background: transparent; color: #e8e8e8; font-size: 12.5px; text-align: left; }
.omnibox-suggestions button:hover, .omnibox-suggestions button.active { background: rgba(255,255,255,.09); }
.omnibox-suggestions button svg { width: 14px; height: 14px; color: #9a9a9a; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; }
.omnibox-suggestions button strong { font-weight: 450; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.omnibox-suggestions button small { margin-left: auto; color: #8a8a8a; font-size: 10.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 40%; flex: none; }
.tab { -webkit-user-drag: element; }
